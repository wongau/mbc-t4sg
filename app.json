{
  "expo": {
    "jsEngine": "hermes",
    "name": "maizenblue",
    "slug": "maizenblue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.maizenblue"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.maizenblue"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "projectId": "5b067b48-296c-4f67-9e3a-21371314438c",
    "plugins": [
      "expo-font",
      "expo-router"
    ]
  }
}
